{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "professor-dashboard-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
